<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/skku_gold_700" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/skku_gold_100" />
            <stroke
                android:width="1dp"
                android:color="@color/skku_gold_300" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/skku_gold_500" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</selector>