<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollVehicleSelect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skk_login">

    <LinearLayout
        android:id="@+id/layoutVehicleSelectRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/textVehicleChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_skk_gold"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="CAR LAB"
            android:textColor="@color/skku_gold_700"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVehicleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Choose your vehicle"
            android:textColor="@color/skku_green_950"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVehicleSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Search, decode VIN, or start with a prepared demo car."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:id="@+id/layoutProfileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textProfileCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buyer profile"
                android:textColor="@color/skku_green_950"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textVehicleUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="User / Region / Priority"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/buttonEditProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_skk_gold"
                android:backgroundTint="@null"
                android:text="Edit region and priority"
                android:textAllCaps="false"
                android:textColor="@color/skku_green_950"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSearchVinButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSearchByName"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_skk_green"
                android:backgroundTint="@null"
                android:text="Search"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonDecodeVin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_skk_gold"
                android:backgroundTint="@null"
                android:text="Decode VIN"
                android:textAllCaps="false"
                android:textColor="@color/skku_green_950"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDemoCarsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_skk_white"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textDemoCarsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Demo vehicle list"
                android:textColor="@color/skku_green_950"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDemoCarsLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="EV, sedan, SUV, van, and truck examples are shown with large category icons."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/layoutDemoVehicleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonSavedReports"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_skk_outline"
            android:backgroundTint="@null"
            android:text="Open saved reports"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_skk_soft"
            android:backgroundTint="@null"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>