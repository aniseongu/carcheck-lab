<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutVinDecode"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textVinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Decode VIN"
        android:textColor="#111827"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textVinDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:text="VIN uses NHTSA vPIC API to identify year, make, model, and vehicle type."
        android:textColor="#4B5563"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <EditText
        android:id="@+id/editVin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:hint="Enter VIN"
        android:padding="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/buttonDecodeVinNow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#111827"
        android:text="DECODE VIN"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textVinResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#FFFBEB"
        android:padding="14dp"
        android:text="VIN result will be shown here."
        android:textColor="#92400E"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <Button
        android:id="@+id/buttonOpenDecodedVehicle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#374151"
        android:text="OPEN DECODED VEHICLE REPORT"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonBackVin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#9CA3AF"
        android:text="BACK"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>