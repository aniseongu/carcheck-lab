<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollVehicleReview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skk_login">

    <LinearLayout
        android:id="@+id/layoutReviewRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/textReviewPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comments &amp; Rating"
            android:textColor="@color/skku_green_950"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textReviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vehicle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAverageRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_skk_soft"
            android:padding="16dp"
            android:text="No ratings yet"
            android:textColor="@color/skku_green_800"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/textMyReviewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/chip_skk_gold"
            android:padding="14dp"
            android:text="One review per user is allowed."
            android:textColor="@color/skku_gold_800"
            android:textSize="13sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/textRatingInputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Your rating"
            android:textColor="@color/skku_green_950"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutStarInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textStar1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="★"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStar2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="★"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStar3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="★"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStar4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="★"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStar5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="★"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/editReviewComment"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_skk"
            android:gravity="top"
            android:hint="Write your comment about this vehicle."
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_skk_green"
            android:backgroundTint="@null"
            android:text="Submit review"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonDeleteReview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_skk_outline"
            android:backgroundTint="@null"
            android:text="Delete my review"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textReviewListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Community reviews"
            android:textColor="@color/skku_green_950"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutReviewList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonBackReview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_skk_outline"
            android:backgroundTint="@null"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>