<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollBlackHole"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:id="@+id/layoutBlackHoleRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F7FA"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textBlackHoleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Budget Black Hole"
            android:textColor="#111827"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBlackHoleSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Price keeps rising. Logic keeps pretending. The budget gets nervous."
            android:textColor="#4B5563"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStageBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFEDD5"
            android:padding="15dp"
            android:text="BUDGET LOOP STAGE 0"
            android:textColor="#C2410C"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressMadness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#F97316"
            android:progressBackgroundTint="#E5E7EB" />

        <LinearLayout
            android:id="@+id/layoutBiasCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textBiasTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bias Lens"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBiasLens"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textBiasComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F9FAFB"
                android:padding="12dp"
                android:text="Bias comment"
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCurrentTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textDefendantLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Escalation Target"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDefendantCar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Vehicle Name"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="$0"
                android:textColor="#DC2626"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRoast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F9FAFB"
                android:padding="14dp"
                android:text="Roast text"
                android:textColor="#374151"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/textWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FEE2E2"
                android:padding="14dp"
                android:text="Warning text"
                android:textColor="#991B1B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:text="Budget Loop History"
            android:textColor="#111827"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/buttonNextLoop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#111827"
            android:text="WITH THAT BUDGET..."
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutSecondaryBlackHoleButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonPreviousLoop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="#374151"
                android:text="BACK ONE STEP"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonShareBlackHole"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:backgroundTint="#374151"
                android:text="SHARE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonBackBlackHole"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#9CA3AF"
            android:text="BACK TO REPORT"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>