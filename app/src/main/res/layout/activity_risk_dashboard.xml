<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skk_login">

    <LinearLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textDashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Risk Report"
            android:textColor="@color/skku_green_950"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSelectedVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selected Vehicle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textProfileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_skk_soft"
            android:padding="12dp"
            android:text="Server User / Profile"
            android:textColor="@color/skku_green_800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/textLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_skk_soft"
            android:padding="12dp"
            android:text="Loading vehicle data..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutTopScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_skk_white"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/layoutRiskCircleBox"
                android:layout_width="164dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <edu.skku.map.carchecklab.CircularScoreView
                    android:id="@+id/circleRiskScore"
                    android:layout_width="158dp"
                    android:layout_height="158dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRiskTextBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textRiskGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Risk Grade"
                    android:textColor="@color/skku_green_950"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRiskComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Risk comment will be shown here."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRatingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/layoutRatingTextBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textRatingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Community Rating"
                    android:textColor="@color/skku_green_950"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAverageRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rating ··· / 5.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonRateFromDashboard"
                android:layout_width="104dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/button_skk_gold"
                android:backgroundTint="@null"
                android:text="Rate"
                android:textAllCaps="false"
                android:textColor="@color/skku_green_950"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textScoreGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_skk_soft"
            android:padding="12dp"
            android:text="Higher is better. Green = Good, Orange = Caution, Red = Weak."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textFinalVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:text="Final Verdict: Calculating..."
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:lineSpacingExtra="6dp" />

        <LinearLayout
            android:id="@+id/layoutScoreSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textScoreSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Score Snapshot"
                android:textColor="@color/skku_green_950"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textWalletScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Wallet: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressWallet"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/textBudgetDefenseScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Budget Defense: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBudgetDefense"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/textHachagamScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hachagam: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressHachagam"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/textPracticalityScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Practicality: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressPracticality"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/textCleanDataScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Clean Data: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressCleanData"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSafetyData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textDataTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Safety Data Snapshot"
                android:textColor="@color/skku_green_950"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRecallCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Recall Count: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textComplaintCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Complaint Count: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSafetyRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Safety Rating: -"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWeatherAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textWeatherTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weather Buying Lens"
                android:textColor="@color/skku_green_950"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textWeatherMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/chip_skk_gold"
                android:padding="11dp"
                android:text="Weather Lens: -"
                android:textColor="@color/skku_gold_800"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textWeatherAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Check: tires · brakes · visibility"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/textWeatherColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ask: Can I see recent tire and brake service records?"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAlternatives"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textAlternativeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top 3 Budget Alternatives"
                android:textColor="@color/skku_green_950"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutAlternativeFocusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textAlternativeFocus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_skk_gold"
                    android:padding="12dp"
                    android:text="Focus: Auto by profile"
                    android:textColor="@color/skku_gold_800"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonEditAlternativeFocus"
                    android:layout_width="92dp"
                    android:layout_height="46dp"
                    android:background="@drawable/button_skk_gold"
                    android:backgroundTint="@null"
                    android:text="Change"
                    android:textAllCaps="false"
                    android:textColor="@color/skku_green_950"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textAlternativeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap an alternative to open its risk report."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutAlternativeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBlackHoleSpotlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/blackhole_spotlight_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textBlackHoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_skk_gold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="EXTRA MODE"
                android:textColor="@color/skku_gold_700"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBlackHoleSpotlightTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Budget Black Hole"
                android:textColor="@color/skku_green_950"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBlackHoleSpotlightBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Watch the budget climb through better car candidates until logic collapses into SKKU-level madness."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/buttonOpenBlackHole"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_skk_green"
                android:backgroundTint="@null"
                android:text="Enter Budget Black Hole"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutActionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_skk_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textSecondaryActionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actions"
                android:textColor="@color/skku_green_950"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutActionRowOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonDetails"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_skk_green"
                    android:backgroundTint="@null"
                    android:text="Issue details"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonSave"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_skk_outline"
                    android:backgroundTint="@null"
                    android:text="Save report"
                    android:textAllCaps="false"
                    android:textColor="@color/skku_green_950"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutActionRowTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonDealerCoach"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_skk_outline"
                    android:backgroundTint="@null"
                    android:text="Dealer coach"
                    android:textAllCaps="false"
                    android:textColor="@color/skku_green_950"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonBackHome"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_skk_soft"
                    android:backgroundTint="@null"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>