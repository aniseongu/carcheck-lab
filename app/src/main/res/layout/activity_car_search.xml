<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCarSearch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skk_login"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/textCarSearchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search vehicle"
        android:textColor="@color/skku_green_950"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSearchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_skk_soft"
        android:padding="14dp"
        android:text="Search hint"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <EditText
        android:id="@+id/editSearchCar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/input_skk"
        android:hint="Hyundai, Kia, Tesla, Camry, EV6..."
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="16sp" />

    <Button
        android:id="@+id/buttonSearchCar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_skk_green"
        android:backgroundTint="@null"
        android:text="Search list"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSelectedSearchCar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_skk_soft"
        android:padding="12dp"
        android:text="Select a vehicle from the list."
        android:textColor="@color/skku_green_800"
        android:textSize="14sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <LinearLayout
        android:id="@+id/layoutSearchActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonOpenReport"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_green"
            android:backgroundTint="@null"
            android:text="Report"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonOpenComments"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_gold"
            android:backgroundTint="@null"
            android:text="Comments ★"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/buttonBackSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_skk_outline"
        android:backgroundTint="@null"
        android:text="Back"
        android:textAllCaps="false"
        android:textColor="@color/skku_green_950"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>