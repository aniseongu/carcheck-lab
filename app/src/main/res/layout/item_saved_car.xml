<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSavedCarItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textSavedVehicleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vehicle Name"
        android:textColor="#111827"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSavedScoreGrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Score / Grade"
        android:textColor="#2563EB"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSavedStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Recall / Complaint / Safety"
        android:textColor="#374151"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSavedTapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tap to preview"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>