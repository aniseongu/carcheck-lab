<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skk_login">

    <LinearLayout
        android:id="@+id/layoutLoginRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="28dp"
        android:paddingEnd="26dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/textBrandChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_skk_gold"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="SKKU EDITION"
            android:textColor="@color/skku_gold_700"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLoginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CarCheck Lab"
            android:textColor="@color/skku_green_950"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLoginSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Smarter car checks before your wallet gets emotional."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:id="@+id/layoutLoginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/card_skk_white"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/textLoginCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="@color/skku_green_950"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLoginCardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Log in to continue your car analysis."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editUserId"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/input_skk"
                android:hint="User ID"
                android:importantForAutofill="no"
                android:inputType="text"
                android:saveEnabled="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_skk"
                android:hint="Password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_skk_green"
                android:backgroundTint="@null"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_skk_gold"
                android:backgroundTint="@null"
                android:text="Create account"
                android:textAllCaps="false"
                android:textColor="@color/skku_green_950"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressLogin"
                style="?android:attr/progressBarStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textLoginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_skk_soft"
                android:padding="12dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textLoginFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Course project demo account system."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>