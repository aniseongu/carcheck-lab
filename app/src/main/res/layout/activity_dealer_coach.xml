<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDealerCoachRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skk_login"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textDealerCoachTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dealer Coach Chat"
        android:textColor="@color/skku_green_950"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCoachVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_skk_white"
        android:padding="14dp"
        android:text="Vehicle info"
        android:textColor="@color/skku_green_800"
        android:textSize="14sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <ScrollView
        android:id="@+id/scrollCoachChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutQuickCoachButtons1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonRecall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_green"
            android:backgroundTint="@null"
            android:text="Recall"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonFuel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_green"
            android:backgroundTint="@null"
            android:text="Fuel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonWeather"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_green"
            android:backgroundTint="@null"
            android:text="Weather"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutQuickCoachButtons2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonPrice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_gold"
            android:backgroundTint="@null"
            android:text="Price"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonBattery"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_gold"
            android:backgroundTint="@null"
            android:text="Battery"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonBackCoach"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/button_skk_outline"
            android:backgroundTint="@null"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/skku_green_950"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCoachInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editCoachQuestion"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/input_skk"
            android:hint="Ask about price, fuel, recall..."
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/buttonSendCoach"
            android:layout_width="86dp"
            android:layout_height="52dp"
            android:background="@drawable/button_skk_green"
            android:backgroundTint="@null"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>